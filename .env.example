# PostgreSQL
DATABASE_URL=postgresql+psycopg://brainwidebench:changeme@db:5432/brainwidebench
POSTGRES_USER=brainwidebench
POSTGRES_PASSWORD=changeme

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# Auth0  (set AUTH0_DOMAIN=dev to disable JWT verification locally)
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.brainwidebench.org

# AWS / S3
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1
S3_BUCKET=brainwidebench-submissions
# S3_STUB=true returns placeholder upload URLs, for working without a bucket.
# S3_ENDPOINT_URL points at MinIO instead of AWS; S3_STUB must be off to use it.
S3_STUB=false

# Ground truth oracle: the prefix holding every suite (ground-truth/ts1/, ts2/, …),
# or a local dir for dev. NOT a single suite's prefix.
S3_GT_PREFIX=ground-truth

# CORS (comma-separated origins, or * for all)
CORS_ORIGINS=*
