# PostgreSQL
#
# Local dev connects to the `db` compose service, started via the `local` profile
# (docker compose --profile local up ...). Production points DATABASE_URL at a managed
# RDS instance instead — no `db` container there — with sslmode=require, e.g.
#   postgresql+psycopg://brainwidebench:<password>@<rds-endpoint>:5432/brainwidebench?sslmode=require
# POSTGRES_USER/POSTGRES_PASSWORD are only read by the local `db` container itself, not by
# the app — irrelevant once DATABASE_URL points at RDS.
DATABASE_URL=postgresql+psycopg://brainwidebench:changeme@db:5432/brainwidebench
POSTGRES_USER=brainwidebench
POSTGRES_PASSWORD=changeme

# Redis / Celery
#
# REDIS_PASSWORD sets the redis compose service's requirepass (docker-compose.yml) — leave
# both unset for local dev. Production must set REDIS_PASSWORD, since Redis is otherwise an
# unauthenticated Celery broker, and repeat the same value in REDIS_URL — env_file values
# aren't shell-interpolated, so REDIS_URL can't reference REDIS_PASSWORD here and the two
# have to be kept in sync by hand, e.g.:
#   REDIS_PASSWORD=<password>
#   REDIS_URL=redis://:<password>@redis:6379/0
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379/0

# Auth0  (set AUTH0_DOMAIN=dev to disable JWT verification locally)
#
# Production needs its OWN tenant, not the free "dev-xxxx.us.auth0.com" tenant used for
# local development — a tenant owns the enabled social connections (Google, GitHub, ...)
# and its users, so sharing one between dev and prod means dev sign-ins and real
# submitters' accounts live in the same place. AUTH0_CLIENT_ID is the SPA application's
# client ID within that tenant — not a secret (see app/schemas/meta.py:AuthConfig) — and
# both are served to the frontend from GET /api/meta/auth-config, so changing tenants is
# an env var change, not a rebuild.
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_AUDIENCE=https://api.brainwidebench.org

# AWS / S3
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1
S3_BUCKET=brainwidebench-submissions
# Two local modes, and production. See docs/local_dev.md.
#
#   simple    S3_STUB=true plus STUB_SUBMISSION_DIR — no object store at all. The browser
#             skips the transfer and validation reads the directory you point it at.
#   realistic S3_ENDPOINT_URL=http://localhost:9000 with the dev-s3 compose profile. Real
#             multipart, real ETags, real CORS, and your own file is what gets checked.
#
# S3_STUB must be off to reach S3_ENDPOINT_URL.
S3_STUB=false
# STUB_SUBMISSION_DIR=/path/to/predictions/mlp-baseline
# S3_ENDPOINT_URL=http://localhost:9000

# Ground truth oracle: the prefix holding every suite (ground-truth/ts1/, ts2/, …),
# or a local dir for dev. NOT a single suite's prefix.
S3_GT_PREFIX=ground-truth

# Worker scratch/ground-truth host paths, bind-mounted to /scratch and /ground-truth
# (docker-compose.yml). Unset defaults to ./.data/... for local dev. In production, point
# at a dedicated EBS volume (issue #42), not the root volume — and sync S3's ground-truth
# tree into BWB_GT_DIR before setting S3_GT_PREFIX below, since an empty dir is used as-is.
# BWB_SCRATCH_DIR=/data/bwb-scratch
# BWB_GT_DIR=/data/bwb-ground-truth
# S3_GT_PREFIX=/ground-truth

# CORS (comma-separated origins, or * for all — dev/local only, with AUTH0_DOMAIN=dev).
# CORSMiddleware runs with allow_credentials=True, and a wildcard origin combined with
# credentialed requests means any site can read the API as a signed-in visitor — so
# Settings refuses to start with CORS_ORIGINS=* outside dev mode. Pin this to the real
# site origin in production, e.g. https://bwb.iblcore.org.
CORS_ORIGINS=*
