# PostgreSQL
DATABASE_URL=postgresql+psycopg://brainwidebench:changeme@db:5432/brainwidebench
POSTGRES_USER=brainwidebench
POSTGRES_PASSWORD=changeme

# Redis / Celery
REDIS_URL=redis://redis:6379/0

# Auth0  (set AUTH0_DOMAIN=dev to disable JWT verification locally)
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_AUDIENCE=https://api.brainwidebench.org

# AWS / S3
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=...
AWS_REGION=us-east-1
S3_BUCKET=brainwidebench-submissions
# Two local modes, and production. See docs/local_dev.md.
#
#   simple    S3_STUB=true plus STUB_SUBMISSION_DIR — no object store at all. The browser
#             skips the transfer and validation reads the directory you point it at.
#   realistic S3_ENDPOINT_URL=http://localhost:9000 with the dev-s3 compose profile. Real
#             multipart, real ETags, real CORS, and your own file is what gets checked.
#
# S3_STUB must be off to reach S3_ENDPOINT_URL.
S3_STUB=false
# STUB_SUBMISSION_DIR=/path/to/predictions/mlp-baseline
# S3_ENDPOINT_URL=http://localhost:9000

# Ground truth oracle: the prefix holding every suite (ground-truth/ts1/, ts2/, …),
# or a local dir for dev. NOT a single suite's prefix.
S3_GT_PREFIX=ground-truth

# CORS (comma-separated origins, or * for all)
CORS_ORIGINS=*
