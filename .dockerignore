# Local environments and build output. A host .venv copied over the image's own leaves a
# venv whose paths point at the build machine.
.venv/
frontend/node_modules/
frontend/dist/
frontend/coverage/
**/__pycache__/
.pytest_cache/
.ruff_cache/
.git/

# Runtime secrets: injected via `env_file` at container start, never needed in the build
# context. COPY . . would otherwise bake these into an image layer.
.env
.env.local
